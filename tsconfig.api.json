{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.api.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["node", "vitest/globals"],
    "skipLibCheck": true,

    /* `bundler` rather than `nodenext`, matching how these files are actually executed:
       tsx for the servers, vitest for the tests, both of which resolve extensionless
       relative imports. Under `nodenext` every local import would need a `.js` suffix
       pointing at a `.ts` file that is never emitted -- ceremony for a build step this
       repository does not have. */
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "resolveJsonModule": true,

    /* Same strictness as the app. The API reads the same nullable bundle, and "the contract
       does not say" has to stay distinguishable from "we failed to read it" on this side of
       the wire too. */
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["api"]
}
